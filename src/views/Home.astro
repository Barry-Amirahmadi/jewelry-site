---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Frame from '../components/Frame.astro';
import PieceCard from '../components/PieceCard.astro';
import { collections, featured, productsIn } from '../data/catalog';
import { editorialAlt } from '../data/alt';
import { ratioFor } from '../data/grounds';
import type { Lang } from '../data/site';
import { t, num } from '../i18n/ui';
import { href } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
const picks = featured();
---

<BaseLayout lang={lang} path="/" title={h.displayB} description={h.lead}>
  <!-- 1. Hero — one statement piece, per the Editorial Collection Showcase pattern -->
  <section class="border-hairline border-b">
    <div class="shell grid items-center gap-12 pt-14 pb-16 md:grid-cols-12 md:pt-20 md:pb-24">
      <div class="md:col-span-7" data-hero>
        <p class="t-eyebrow" data-reveal>{h.eyebrow}</p>
        <h1 class="t-display text-ink mt-6" data-reveal>
          {h.displayA}<br />
          <span class="text-gold">{h.displayB}</span>
        </h1>
        <p class="t-lead text-muted-fg mt-8 max-w-xl" data-reveal>{h.lead}</p>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal>
          <a class="btn btn-primary" href={href('/collections', lang)}>
            {h.ctaPrimary}
            <Icon name="arrow-right" size={16} class="rtl:rotate-180" />
          </a>
          <a class="btn btn-ghost" href={href('/contact', lang)}>{h.ctaSecondary}</a>
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="mx-auto max-w-sm" data-reveal>
          <Frame
            slug="hero-necklace"
            alt={editorialAlt('hero-necklace', lang)}
            ratio={ratioFor('hero-necklace')}
            loading="eager"
            priority
            sizes="(min-width: 768px) 384px, 86vw"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Collections -->
  <section class="section border-hairline border-b" aria-labelledby="home-collections">
    <div class="shell">
      <p class="t-eyebrow" data-reveal>{h.collectionsEyebrow}</p>
      <h2 id="home-collections" class="t-h2 text-ink mt-4 max-w-2xl" data-reveal>
        {h.collectionsHeading}
      </h2>
      <p class="t-lead text-muted-fg mt-5 max-w-2xl" data-reveal>{h.collectionsLead}</p>

      <ul class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          collections.map((collection) => (
            <li>
              <a
                href={href(`/collections/${collection.slug}`, lang)}
                class="piece group"
                data-reveal
                aria-label={`${collection.name[lang]} — ${d.common.piecesCount(productsIn(collection.slug).length)}`}
              >
                <Frame
                  slug={collection.slug}
                  alt=""
                  ratio="3 / 2"
                  motif={collection.motif}
                  tone={collection.tone}
                  sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 92vw"
                />
                <h3 class="t-h3 text-ink mt-5">{collection.name[lang]}</h3>
                <p class="text-muted-fg mt-1.5 text-sm">{collection.tagline[lang]}</p>
                <p class="text-gold mt-3 inline-flex items-center gap-1.5 text-xs">
                  {d.common.piecesCount(productsIn(collection.slug).length)}
                  <Icon
                    name="arrow-right"
                    size={14}
                    class="transition-transform duration-200 group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5"
                  />
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Craft and provenance -->
  <section class="section bg-ink text-white" aria-labelledby="home-craft">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="t-eyebrow text-white/60" data-reveal>{h.craftEyebrow}</p>
          <h2 id="home-craft" class="t-h2 mt-4" data-reveal>{h.craftHeading}</h2>
          <p class="t-lead mt-6 text-white/75" data-reveal>{h.craftBody}</p>
        </div>

        <div class="lg:col-span-7 lg:ps-8">
          <dl class="grid gap-px" data-stagger>
            {
              h.craftPoints.map((point, index) => (
                <div class="border-t border-white/15 pt-6 pb-8" data-reveal>
                  <dt class="flex items-baseline gap-4">
                    <span class="text-gold-on-dark text-xs">{num(index + 1, lang)}</span>
                    <span class="display text-xl md:text-2xl">{point.title}</span>
                  </dt>
                  <dd class="mt-3 max-w-xl ps-9 text-sm leading-relaxed text-white/70">
                    {point.body}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Featured pieces -->
  <section class="section border-hairline border-b" aria-labelledby="home-featured">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="t-eyebrow" data-reveal>{h.featuredEyebrow}</p>
          <h2 id="home-featured" class="t-h2 text-ink mt-4 max-w-xl" data-reveal>
            {h.featuredHeading}
          </h2>
        </div>
        <a class="btn btn-quiet" href={href('/collections', lang)} data-reveal>
          {d.common.allCollections}
        </a>
      </div>
      <p class="t-lead text-muted-fg mt-5 max-w-2xl" data-reveal>{h.featuredLead}</p>

      <ul class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {picks.map((product) => <li><PieceCard product={product} lang={lang} /></li>)}
      </ul>
    </div>
  </section>

  <!-- 5. Visit -->
  <section class="section" aria-labelledby="home-visit">
    <div class="shell grid items-center gap-12 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="t-eyebrow" data-reveal>{h.visitEyebrow}</p>
        <h2 id="home-visit" class="t-h2 text-ink mt-4 max-w-xl" data-reveal>{h.visitHeading}</h2>
        <p class="t-lead text-muted-fg mt-6 max-w-xl" data-reveal>{h.visitBody}</p>
        <div class="mt-9" data-reveal>
          <a class="btn btn-primary" href={href('/contact', lang)}>
            {h.visitCta}
            <Icon name="arrow-right" size={16} class="rtl:rotate-180" />
          </a>
        </div>
      </div>
      <div class="md:col-span-5">
        <figure class="mx-auto max-w-xs" data-reveal>
          <Frame
            slug="workshop-bench"
            alt={editorialAlt('workshop-bench', lang)}
            ratio={ratioFor('workshop-bench')}
            sizes="(min-width: 768px) 320px, 80vw"
          />
          <figcaption class="text-muted-fg mt-3 text-xs leading-relaxed">
            {h.captionVisit}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>
</BaseLayout>
