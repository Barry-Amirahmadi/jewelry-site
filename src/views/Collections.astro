---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Frame from '../components/Frame.astro';
import { collections, productsIn } from '../data/catalog';
import type { Lang } from '../data/site';
import { t } from '../i18n/ui';
import { href } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const c = d.collections;
---

<BaseLayout lang={lang} path="/collections" title={c.title} description={c.lead}>
  <PageHeader eyebrow={c.eyebrow} title={c.title} lead={c.lead} />

  <section class="section">
    <div class="shell">
      <ul class="grid gap-x-10 gap-y-16 md:grid-cols-2" data-stagger>
        {
          collections.map((collection) => (
            <li>
              <a
                href={href(`/collections/${collection.slug}`, lang)}
                class="piece group"
                data-reveal
                aria-label={`${collection.name[lang]} — ${d.common.piecesCount(productsIn(collection.slug).length)}`}
              >
                <Frame
                  slug={collection.slug}
                  alt=""
                  ratio="3 / 2"
                  motif={collection.motif}
                  tone={collection.tone}
                  sizes="(min-width: 768px) 46vw, 92vw"
                />

                <div class="mt-6 flex items-start justify-between gap-6">
                  <div>
                    <h2 class="t-h2 text-ink">{collection.name[lang]}</h2>
                    <p class="text-muted-fg mt-2 text-sm">{collection.tagline[lang]}</p>
                  </div>
                  <span class="t-eyebrow shrink-0 pt-2">
                    {d.common.piecesCount(productsIn(collection.slug).length)}
                  </span>
                </div>

                <p class="text-muted-fg mt-5 max-w-xl text-sm leading-relaxed">
                  {collection.intro[lang]}
                </p>

                <span class="text-gold mt-5 inline-flex items-center gap-2 text-xs">
                  {c.inThisCollection}
                  <Icon
                    name="arrow-right"
                    size={14}
                    class="transition-transform duration-200 group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5"
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
