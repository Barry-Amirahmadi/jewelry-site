---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import type { Lang } from '../data/site';
import { t } from '../i18n/ui';
import { href } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const f = d.faq;

/* Native <details> rather than a scripted accordion: keyboard-operable,
   announced correctly, findable by in-page search, and works without JS. */
---

<BaseLayout lang={lang} path="/faq" title={f.title} description={f.lead}>
  <PageHeader eyebrow={f.eyebrow} title={f.title} lead={f.lead} />

  <section class="section">
    <div class="shell max-w-3xl">
      <div data-stagger>
        {
          f.items.map((item) => (
            <details class="group border-hairline border-b" data-reveal>
              <summary
                class="text-ink flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-5 text-start [&::-webkit-details-marker]:hidden"
              >
                <span class="display text-lg md:text-xl">{item.q}</span>
                <span
                  class="border-field text-ink grid size-8 shrink-0 place-items-center border transition-colors duration-200 group-open:border-gold group-open:text-gold"
                >
                  <Icon name="plus" size={14} class="block group-open:hidden" />
                  <Icon name="minus" size={14} class="hidden group-open:block" />
                </span>
              </summary>
              <p class="text-muted-fg pb-6 leading-relaxed">{item.a}</p>
            </details>
          ))
        }
      </div>

      <div class="mt-14" data-reveal>
        <p class="text-muted-fg">{f.lead}</p>
        <a class="btn btn-primary mt-5" href={href('/contact', lang)}>
          {d.nav.contact}
          <Icon name="arrow-right" size={16} class="rtl:rotate-180" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
