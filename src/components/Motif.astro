---
/**
 * Decorative line-art motif standing in for product photography.
 *
 * Purely decorative: aria-hidden, with the accessible name coming from the
 * surrounding link or heading. Inline SVG means no image request, no layout
 * shift and no resolution ceiling.
 */
import type { Motif, Tone } from '../data/catalog';

interface Props {
  motif: Motif;
  tone?: Tone;
  class?: string;
}

const { motif, tone = 'stone', class: className = '' } = Astro.props;

const tones: Record<Tone, string> = {
  stone: '#F5F5F4',
  sand: '#F1EBE2',
  clay: '#EDE6E0',
  ash: '#EAE8E4',
};
---

<svg
  class={`h-full w-full ${className}`}
  viewBox="0 0 400 500"
  role="presentation"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="400" height="500" fill={tones[tone]} />

  <g
    fill="none"
    stroke="#A16207"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    opacity="0.82"
  >
    {
      motif === 'ring' && (
        <>
          <ellipse cx="200" cy="292" rx="86" ry="92" />
          <ellipse cx="200" cy="292" rx="66" ry="72" opacity="0.5" />
          <circle cx="200" cy="182" r="19" />
          <path d="M181 182 L200 156 L219 182" />
          <path d="M186 196 L182 208 M214 196 L218 208" opacity="0.6" />
        </>
      )
    }
    {
      motif === 'necklace' && (
        <>
          <path d="M100 108 C100 252 138 330 200 332 C262 330 300 252 300 108" />
          <path d="M108 108 C108 248 144 322 200 324 C256 322 292 248 292 108" opacity="0.35" />
          <ellipse cx="200" cy="342" rx="11" ry="14" />
          <circle cx="200" cy="382" r="29" />
          <circle cx="200" cy="382" r="13" opacity="0.5" />
        </>
      )
    }
    {
      motif === 'earring' && (
        <>
          <path d="M200 128 C168 128 166 168 198 176" />
          <circle cx="200" cy="184" r="10" />
          <path d="M200 202 C164 250 164 306 200 340 C236 306 236 250 200 202 Z" />
          <path d="M200 232 C184 258 184 288 200 308" opacity="0.4" />
        </>
      )
    }
    {
      motif === 'bracelet' && (
        <>
          <ellipse cx="200" cy="268" rx="128" ry="88" />
          <ellipse cx="200" cy="268" rx="104" ry="66" opacity="0.5" />
          <path d="M318 252 L332 252 L332 284 L318 284" opacity="0.7" />
          <path d="M70 262 L58 262" opacity="0.45" />
        </>
      )
    }
  </g>

  <!-- A single hairline grounds the composition without competing with it. -->
  <path d="M0 440 H400" stroke="#D6D3D1" stroke-width="1" opacity="0.7" />
</svg>
